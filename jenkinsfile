pipeline {
    agent any

    environment {
        PATH = "/opt/homebrew/bin:/usr/local/bin:/Applications/Docker.app/Contents/Resources/bin:${env.PATH}"
        AWS_REGION = 'ap-south-1'
        INSTANCE_ID = 'i-03252ed8cef99290c'
        IMAGE = 'kamesprabu/muse-app:latestv1'
        CONTAINER = 'muse-app'
        ALB_URL = 'http://muse-app-alb-312535184.ap-south-1.elb.amazonaws.com'
    }

    stages {
        stage('Deploy Existing Docker Image') {
            steps {
                withCredentials([[
                    $class: 'AmazonWebServicesCredentialsBinding',
                    credentialsId: 'aws-jenkins'
                ]]) {
                    sh '''
                        set -e
                        which aws

                        CMD_ID=$(aws ssm send-command \
                          --region "$AWS_REGION" \
                          --instance-ids "$INSTANCE_ID" \
                          --document-name "AWS-RunShellScript" \
                          --parameters "commands=[\\"docker pull $IMAGE\\",\\"docker rm -f $CONTAINER || true\\",\\"docker run -d --name $CONTAINER --restart unless-stopped -p 80:80 $IMAGE\\"]" \
                          --query 'Command.CommandId' \
                          --output text)

                        echo "SSM Command ID: $CMD_ID"

                        aws ssm wait command-executed \
                          --region "$AWS_REGION" \
                          --command-id "$CMD_ID" \
                          --instance-id "$INSTANCE_ID"
                    '''
                }
            }
        }

        stage('Application Health Check') {
            steps {
                sh '''
                    curl -fsS --retry 10 --retry-delay 5 \
                      --retry-all-errors "$ALB_URL/health.html"
                '''
            }
        }
    }
}