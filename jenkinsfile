pipeline {
    agent any

    environment {
        PATH = "/opt/homebrew/bin:/usr/local/bin:/Applications/Docker.app/Contents/Resources/bin:${env.PATH}"
        AWS_REGION = 'ap-south-1'
        INSTANCE_ID = 'i-03252ed8cef99290c'
        IMAGE = 'kamesprabu/muse-app'
        PREV_TAG = 'latestv1'
        CONTAINER = 'muse-app'
        ALB_URL = 'http://muse-app-alb-312535184.ap-south-1.elb.amazonaws.com'
        PLATFORM = 'linux/arm64'
    }

    stages {
        stage('Build and Push Docker Image') {
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'ockerhub-creds',
                        usernameVariable: 'DH_USER',
                        passwordVariable: 'DH_PASS'
                    ),
                    string(
                        credentialsId: 'supabase-url',
                        variable: 'SUPABASE_URL'
                    ),
                    string(
                        credentialsId: 'supabase-key',
                        variable: 'SUPABASE_KEY'
                    )
                ]) {
                    sh '''
                        set -e
                        echo "$DH_PASS" | docker login -u "$DH_USER" --password-stdin

                        docker buildx build \
                          --platform "$PLATFORM" \
                          --build-arg VITE_SUPABASE_URL="$SUPABASE_URL" \
                          --build-arg VITE_SUPABASE_ANON_KEY="$SUPABASE_KEY" \
                          -t "$IMAGE:$BUILD_NUMBER" \
                          -t "$IMAGE:latest" \
                          --push .
                    '''
                }
            }
        }

        stage('Deploy and Verify') {
            steps {
                withCredentials([[
                    $class: 'AmazonWebServicesCredentialsBinding',
                    credentialsId: 'aws-jenkins'
                ]]) {
                    script {
                        try {
                            deployTag(env.BUILD_NUMBER)

                            sh '''
                                curl -fsS --retry 10 \
                                  --retry-delay 5 \
                                  --retry-all-errors \
                                  "$ALB_URL/does-not-exist-test-rollback"
                            '''
                        } catch (e) {
                            echo 'Deployment or health check failed. Rolling back.'
                            deployTag(env.PREV_TAG)

                            try {
                                sh '''
                                    curl -fsS --retry 10 \
                                      --retry-delay 5 \
                                      --retry-all-errors \
                                      "$ALB_URL/health.html"
                                '''
                                echo "Rollback to ${env.PREV_TAG} verified — application is healthy."
                            } catch (rollbackErr) {
                                error("CRITICAL: Both deployment AND rollback verification failed. The application may be down. Rollback tag: ${env.PREV_TAG}")
                            }

                            error("Deployment failed. Rolled back successfully to ${env.PREV_TAG}")
                        }
                    }
                }
            }
        }
    }
}

def deployTag(String tag) {
    withEnv(["TAG=${tag}"]) {
        sh '''
            set -e

            CMD_ID=$(aws ssm send-command \
              --region "$AWS_REGION" \
              --instance-ids "$INSTANCE_ID" \
              --document-name AWS-RunShellScript \
              --parameters "commands=[\\"docker pull $IMAGE:$TAG\\",\\"docker rm -f $CONTAINER || true\\",\\"docker run -d --name $CONTAINER --restart unless-stopped -p 80:80 $IMAGE:$TAG\\"]" \
              --query Command.CommandId \
              --output text)

            echo "SSM Command ID: $CMD_ID"

            aws ssm wait command-executed \
              --region "$AWS_REGION" \
              --command-id "$CMD_ID" \
              --instance-id "$INSTANCE_ID"
        '''
    }
}
